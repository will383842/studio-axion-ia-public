          "dessinId": "document",
          "cote": "droite",
          "id": "e10",
          "ancre": 6
        },
        {
          "type": "ligne",
          "texte": "Notez chaque tâche faite plus d'une fois, en trois mots.",
          "niveau": "texte",
          "role": "regle",
          "bloc": "detail",
          "id": "e11",
          "ancre": 10
