  "douleur": "Vous finissez à dix-neuf heures sans savoir où est passée la journée.",
  "gesteMinute": "Avant de parler d'IA : repérer en une semaine les tâches répétitives qui vous coûtent le plus de temps",
  "scenes": [
    {
      "id": "s01",
      "role": "accroche",
      "page": 1,
      "texteDit": "Vous finissez à dix-neuf heures sans savoir où est passée la journée. Vous avez recopié des adresses, relancé des factures, répondu trois fois à la même question.",
      "elements": [
        {
          "type": "ligne",
          "texte": "La journée perdue",
          "niveau": "titre",
          "role": "alerte",
          "bloc": "titre",
          "id": "e01",
          "ancre": 0
        },
        {
          "type": "ligne",
          "texte": "Dix-neuf heures : où est passée la journée ?",
          "niveau": "texte",
          "role": "alerte",
          "bloc": "phrase-cle",
          "marque": "entoure",
          "id": "e02",
          "ancre": 1
        },
        {
