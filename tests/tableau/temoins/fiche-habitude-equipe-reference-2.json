    {
      "id": "s02",
      "role": "idee-recue",
      "page": 2,
      "texteDit": "Le problème n'est pas la formation. Une formation apporte des savoirs, pas des réflexes. Un réflexe naît d'un geste répété, toujours au même moment. Voici quatre étapes pour en ancrer un seul, en trente jours.",
      "elements": [
        {
          "type": "ligne",
          "texte": "Pas la formation",
          "niveau": "titre",
          "role": "alerte",
          "bloc": "titre",
          "id": "e06",
          "ancre": 0
        },
        {
          "type": "ligne",
          "texte": "Une formation apporte des savoirs, pas des réflexes.",
          "niveau": "texte",
          "role": "regle",
          "bloc": "phrase-cle",
          "id": "e07",
          "ancre": 6
        },
        {
          "type": "dessin",
          "dessinId": "fleche-boucle",
          "cote": "droite",
          "id": "e08",
          "ancre": 15
        },
        {
          "type": "ligne",
          "texte": "Un réflexe naît d'un geste répété, au même moment.",
          "niveau": "texte",
          "role": "regle",
          "bloc": "detail",
          "id": "e09",
          "ancre": 14
        },
        {
          "type": "ligne",
          "texte": "Quatre étapes pour en ancrer un seul, en trente jours.",
          "niveau": "texte",
          "role": "avantage",
          "bloc": "detail",
          "id": "e10",
          "ancre": 24
        }
      ],
      "gabarit": {
        "role": "probleme"
      }
    },
    {
      "id": "s03",
      "role": "etape",
      "page": 3,
      "texteDit": "Un. Choisissez une seule tâche, la même pour toute l'équipe. Pas dix usages possibles : un seul, que tout le monde fait chaque semaine.",
      "elements": [
        {
          "type": "ligne",
          "texte": "Une seule tâche",
          "niveau": "titre",
          "role": "regle",
          "bloc": "titre",
          "id": "e11",
          "ancre": 1
        },
        {
          "type": "ligne",
          "texte": "Choisissez une seule tâche, la même pour toute l'équipe.",
          "niveau": "texte",
          "role": "regle",
          "bloc": "phrase-cle",
          "id": "e12",
          "ancre": 1
        },
        {
          "type": "dessin",
          "dessinId": "cible",
          "cote": "droite",
          "id": "e13",
          "ancre": 9
        },
        {
          "type": "ligne",
          "texte": "Pas dix usages : un seul, fait chaque semaine.",
          "niveau": "texte",
          "role": "regle",
          "bloc": "detail",
          "id": "e14",
          "ancre": 10
        }
      ],
      "gabarit": {
        "role": "etape",
