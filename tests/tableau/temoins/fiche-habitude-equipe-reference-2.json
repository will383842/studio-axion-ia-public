          "role": "regle",
          "bloc": "detail",
          "id": "e18",
          "ancre": 9
        },
        {
          "type": "ligne",
          "texte": "Le déclencheur, c'est la réunion. Pas la bonne volonté.",
          "niveau": "texte",
          "role": "regle",
