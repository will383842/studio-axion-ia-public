          "n": 1,
          "ancre": 0
        }
      }
    },
    {
      "id": "s04",
      "role": "etape",
      "page": 4,
      "texteDit": "Deux. Accrochez-la à un moment fixe qui existe déjà. Par exemple : en sortant de chaque réunion, dictez trois notes à l'IA pour le compte rendu. Le déclencheur, c'est la réunion. Pas la bonne volonté.",
      "elements": [
        {
          "type": "ligne",
          "texte": "Un moment fixe",
          "niveau": "titre",
          "role": "regle",
