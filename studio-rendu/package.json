{
  "name": "studio-rendu",
  "version": "0.1.0",
  "private": true,
  "description": "Conteneur SANS ÉTAT du Studio vidéo Axion-IA : FFmpeg, ffprobe, Remotion. Deux files (courte prioritaire, longue un à la fois). Lot M1b.",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "verifier": "tsc -p tsconfig.json --noEmit",
