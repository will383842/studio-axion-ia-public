# Modèle de /opt/studio-axion-ia/.env (sur le serveur, JAMAIS dans le dépôt). Aucune valeur réelle ici.
# Une variable vide = l'outil reste simulé : le studio fonctionne sans aucune d'elles.

# --- Déjà en place (mise en ligne) ---
POSTGRES_PASSWORD=
STUDIO_PASSWORD_HASH_B64=
SESSION_SECRET=
# Clé FIXE des actions serveur (10/10) : sans elle, chaque mise en ligne change les identifiants des actions et une
# page restée ouverte échoue (« Failed to find Server Action »). Générée UNE fois : openssl rand -base64 32
# Lue à la CONSTRUCTION de l'image (docker-compose.yml, build.args). Ne pas la changer sans raison : la changer revient
# à une mise en ligne « à l'ancienne » (pages ouvertes rechargées une fois, textes gardés).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Lot M0b : voix HeyGen réelle ---
# Lot R7 : la même clé suffit pour lire les vidéos faites dans l'application HeyGen (« Ma vidéo HeyGen », gratuit) ;
# leur téléchargement exige le stockage R2 (FOURNISSEUR_STOCKAGE=r2). Le studio ne lance aucun rendu d'avatar.
HEYGEN_API_KEY=
# Lot R7 : taille maximale d'une vidéo HeyGen téléchargée, en Mo (vide = 2048). Au-delà, refus sans téléchargement.
HEYGEN_VIDEO_MAX_MO=
# heygen (après le test d'écoute) ; vide = simulation
FOURNISSEUR_VOIX=

# --- Lot M1b : crochet HeyGen (réveil). Vide = la route répond 501. ---
HEYGEN_WEBHOOK_SECRET=

# --- Lot M1b : stockage Cloudflare R2 (seau privé + clé d'accès « Objet lecture et écriture » limitée au seau) ---
# Activation : FOURNISSEUR_STOCKAGE=r2. Règle CORS du seau : deploiement/r2-cors.json.
FOURNISSEUR_STOCKAGE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Facultatif : hôte du point d'accès S3 (seau européen : {compte}.eu.r2.cloudflarestorage.com)
R2_PUBLIC_HOST=

# --- Lots M1b et R3 : notifications (téléphone + e-mail). Rien ne part tant que la carte est en simulation. ---
# Activation : FOURNISSEUR_NOTIFICATION=web-push-email (ou Réglages > Connexions > Notifications). Vide = simulation.
FOURNISSEUR_NOTIFICATION=
# Téléphone (Web Push, aucun compte). Clés générées UNE fois : npx web-push generate-vapid-keys --json
# (publicKey -> VAPID_PUBLIQUE, privateKey -> VAPID_PRIVEE). Changer de clés désabonne tous les téléphones.
VAPID_PUBLIQUE=
VAPID_PRIVEE=
# mailto:contact@axion-ia.com
VAPID_SUJET=

# E-mail (ZeptoMail, même compte que le site ; domaine axion-ia.com vérifié, DMARC p=reject).
# Jeton « Send Mail » d'un agent ZeptoMail « Studio » ; expéditeur studio@axion-ia.com (jamais noreply@) ;
# destinataire = l'adresse qui reçoit les alertes.
EMAIL_SECOURS_CLE=
EMAIL_SECOURS_EXPEDITEUR=
EMAIL_SECOURS_DESTINATAIRE=

# --- Lot M1b : conteneur de rendu. Vide = rendu simulé ; réel : http://studio-rendu:4100 ---
STUDIO_RENDU_URL=
# Clé partagée entre le studio et studio-rendu, en plus du réseau interne : openssl rand -hex 32
# OBLIGATOIRE en production (relecture sécurité R45) : sans elle, studio-rendu refuse de démarrer, et le studio refuse
# STUDIO_RENDU_URL.
STUDIO_RENDU_CLE=
# studio-rendu ne lit et n'écrit QUE le stockage R2 du compte (R2_ACCOUNT_ID / R2_PUBLIC_HOST ci-dessus, transmises au
# conteneur). Hôtes en plus, séparés par des virgules (facultatif, vide en temps normal) :
STUDIO_RENDU_HOTES=
# Lot M4 : montage réel (Remotion + FFmpeg) dans studio-rendu, une fois STUDIO_RENDU_URL et R2 reliés.
FOURNISSEUR_MONTAGE=
# Pages du navigateur en parallèle pour un montage. Vide = automatique (lot M4b : la moitié des cœurs du conteneur,
# de 1 à 4). Une ancienne valeur « 2 » reste valable (le texte seul passe encore par le navigateur).
STUDIO_RENDU_CONCURRENCE=
# Note de qualité VMAF de chaque export (docs/JOURNAL-FFMPEG8-QUALITE.md) : seuil (vide = 93) sous lequel l'export est
# relancé UNE fois plus fin et une alerte qualité est posée ; STUDIO_RENDU_VMAF=non coupe la note.
STUDIO_RENDU_VMAF_MIN=
STUDIO_RENDU_VMAF=
# Lot M4b — Remotion Lambda : écrit, ÉTEINT. À remplir seulement si Will ouvre un compte AWS (marche à suivre :
# studio-rendu/src/remotion-lambda.ts). Tant que REMOTION_LAMBDA_ACTIVE n'est pas « true », rien ne part chez AWS.
REMOTION_LAMBDA_ACTIVE=
REMOTION_LAMBDA_REGION=
REMOTION_LAMBDA_FONCTION=
REMOTION_LAMBDA_SITE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Lot A2 (M5) : illustrations réelles. Vide = simulation. Activation : FOURNISSEUR_ILLUSTRATION=reel ---
FOURNISSEUR_ILLUSTRATION=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# fal.ai : un seul compte pour les images générées et les clips animés (payé à l'usage)
FAL_KEY=

# --- Lot B1 : décors réalistes (Looks HeyGen, même HEYGEN_API_KEY). Activation : FOURNISSEUR_VISAGE=heygen ---
FOURNISSEUR_VISAGE=

# --- Lot B2 : veille des outils (une lecture par jour). STUDIO_VEILLE=0 la coupe. Jeton GitHub facultatif (lecture seule publique). ---
STUDIO_VEILLE=
GITHUB_TOKEN_VEILLE=

# --- Claude : générateur de scripts (lots G0 → G6b). Clé déjà posée en production. ---
# La clé seule ne dépense RIEN : Claude écrit seulement s'il est CHOISI (Réglages > Connexions, ou FOURNISSEUR_SCRIPT=claude).
# Limites : 100 $ par mois (réglable dans Réglages), 1,50 $ par sujet. Vide = essai (aucun appel).
# = clé du compte Claude 1 (abonnement 1).
ANTHROPIC_API_KEY=
# Comptes Claude 2 et 3 : le studio passe de l'un à l'autre tout seul quand un compte est épuisé. Vides = non utilisés.
ANTHROPIC_API_KEY_2=
ANTHROPIC_API_KEY_3=
# API payante : 4e source, JAMAIS utilisée automatiquement (seulement si Will la choisit à la main dans Réglages).
ANTHROPIC_API_KEY_PAYANTE=
# Laisser VIDE au premier démarrage ; « claude » quand Will est prêt à dépenser (le réglage de l'écran suffit aussi).
FOURNISSEUR_SCRIPT=

# --- Coupures de secours (vide = actif ; « 0 » = coupé, puis redémarrer le conteneur) ---
# Boucle d'écriture du générateur (toutes les 4 s) : « 0 » = plus aucun appel Claude ne part.
STUDIO_BOUCLE_GENERATION=
# Boucle de fond des fabrications (toutes les 5 s).
STUDIO_BOUCLE=
# Délais de garde en minutes (vides = ceux du code) : rendu sans nouvelle ; garde globale d'un montage tableau.
STUDIO_RENDU_SANS_NOUVELLE_MIN=
STUDIO_TABLEAU_GARDE_MIN=

# --- Plafond de dépense fal.ai propre au processus, en dollars (facultatif ; vide = seul le budget du studio s'applique) ---
FAL_PLAFOND_USD=

# --- Mesures (lot G7, « Mettre à jour les mesures ») : LECTURE SEULE. Vide = mode essai, rien n'est lu ni inventé. ---
# Plausible : clé de LECTURE des statistiques ; sans elle, les visites par lien suivi restent vides.
PLAUSIBLE_KEY=
# Facultatives : défauts du code https://plausible.axion-ia.com et axion-ia.com.
PLAUSIBLE_URL=
PLAUSIBLE_SITE=
# Buffer : lecture des statistiques des publications (jamais de publication). Sans clé : saisie à la main.
BUFFER_API_KEY=

# --- Facultatives, défauts du code si vides ---
# Adresse publique du studio dans les e-mails de secours (défaut https://studio.axion-ia.com).
STUDIO_ADRESSE=
# Point d'envoi ZeptoMail des e-mails de secours (défaut https://api.zeptomail.eu/v1.1/email).
EMAIL_SECOURS_ADRESSE=

# --- DÉVELOPPEMENT SEULEMENT : ne JAMAIS les poser sur le serveur (le compose ne les transmet pas, et le code les
# ignore quand NODE_ENV=production) ---
# STUDIO_APERCU_MESURES=1         exemples de mesures pour les captures
# CREDITS_ESSAI="heygen=10"       remplace la lecture des soldes (essais locaux)
# STUDIO_SIMULATION_LENTEUR_MS=   lenteur de l'écriture simulée
# STUDIO_SANS_BASE=1              essai local d'un serveur construit SANS base (sinon il refuse de démarrer)
# GOOGLE_DRIVE_ESSAI=expire       écrans de repli du double Google Drive (expire|refuse|coupure)

# --- Lot « intensité · crédits · calage » (02/10) ---
# Calage des sous-titres au mot près (WhisperX, conteneur studio-aligneur). Vide = simulation.
# Lot R6 : STUDIO_ALIGNEUR_URL=http://studio-aligneur:4200 et FOURNISSEUR_ALIGNEMENT=studio-aligneur (clé partagée :
# STUDIO_RENDU_CLE). Poser l'adresse fait aussi construire et démarrer le conteneur (mettre-a-jour.sh, profil « calage »).
# Les prises filmées sont alors calées ; la voix de synthèse ne l'est pas (réglage « alignement.voixSynthese », coupé).
STUDIO_ALIGNEUR_URL=
FOURNISSEUR_ALIGNEMENT=
# Audit D : délai maximal d'un calcul de calage, en secondes (vide = 900, soit 15 min ; le studio abandonne à 20 min).
STUDIO_ALIGNEUR_DELAI_SEC=
# Crédits : ElevenLabs (secours) — solde lu seulement si la clé existe. Une clé par service ET par usage (« studio-video-prod »).
ELEVENLABS_API_KEY=

# --- Lot E2 : import depuis Google Drive (lecture seule, docs/facecam/JOURNAL-E2.md) ---
# Vide = double de simulation (aucun appel à Google). Réel : « google » + les deux clés de la console Google Cloud.
FOURNISSEUR_GOOGLE_DRIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Adresse de retour inscrite dans la console Google (vide = ${STUDIO_ADRESSE}/api/google-drive/retour,
# soit https://studio.axion-ia.com/api/google-drive/retour).
GOOGLE_REDIRECTION=
# Compte proposé d'office sur la page Google (facultatif), ex. compte@exemple.fr.
GOOGLE_DRIVE_COMPTE=
# Clé de chiffrement des jetons Google (32 caractères au moins). Vide = dérivée de SESSION_SECRET.
GOOGLE_DRIVE_CLE=
# Essais locaux du double : GOOGLE_DRIVE_ESSAI (développement seulement, voir plus haut).

# --- Lot E1 : Décor IA (Higgsfield, docs/facecam/JOURNAL-E1.md) ---
# Vides = double de simulation (aucun appel, aucun crédit). Le réel exige la clé ET l'adresse https de l'API, puis le
# réglage caché « facecam.decorIa.reel » ; l'option « Décor IA » reste coupée par défaut (Réglages).
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_URL=

# --- Idées de l'usine (Écrire > Idées). FACULTATIF : sans l'une des deux, le bloc est éteint et rien ne change. ---
# Adresse de l'usine (ex. https://usine.exemple) et clé de sa porte API (32 caractères AU MOINS, la même que côté usine ; plus courte, le bloc reste éteint). Appels faits côté serveur uniquement.
USINE_URL=
USINE_PORTE_SECRET=

# --- Vidéos sur le site (lots S3-S4, docs/site-videos/PLAN-LOTS-STUDIO.md) ---
# Vides = le site factice (simulation) : rien n'est envoyé. Le vrai client est écrit, testé contre le site factice, et
# JAMAIS choisi par défaut : le brancher est une décision de Will (réglage « fournisseur.site »).
# Adresse du site (ex. https://axion-ia.com) et secret partagé avec lui (le même côté site). Appels faits côté serveur uniquement.
SITE_VIDEOS_URL=
SITE_VIDEOS_SECRET=
